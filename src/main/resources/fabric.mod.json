{
  "schemaVersion": 1,
  "id": "ordersmp-clips",
  "version": "${version}",
  "name": "OrderSMP Clips",
  "description": "Saves your best moments. Keeps the last minutes ready, clips fights by itself, and lets you trim and share them.",
  "authors": [
    "OrderSMP"
  ],
  "contact": {
    "homepage": "https://github.com/Kalvisan/ordersmp-clips",
    "sources": "https://github.com/Kalvisan/ordersmp-clips",
    "issues": "https://github.com/Kalvisan/ordersmp-clips/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "lv.ordersmp.clips.ClipsClient"
    ],
    "voicechat": [
      "lv.ordersmp.clips.voice.ClipsVoicePlugin"
    ]
  },
  "mixins": [
    "ordersmp-clips.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": "*"
  }
}
